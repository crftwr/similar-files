# Copy to docker/.env and edit. Paths are made-up examples for a Synology NAS.

# The shared folder to scan, as the NAS sees it...
MEDIA_HOST_DIR=/volume1/photo
# ...and as your computer sees it (the path XeFM opens). Playlist lines use it.
MEDIA_CLIENT_DIR=/Volumes/photo

# Where the playlists go. Put it on a share, so XeFM can open them.
OUT_HOST_DIR=/volume1/homes/me/similar-groups
# The feature cache. Keep it; deleting it only costs a rescan.
CACHE_HOST_DIR=/volume1/docker/similar-files/cache

# Your NAS user and group (run `id` over SSH). Both folders above must be
# writable by them; create them before the first run.
PUID=1026
PGID=100

# identical, image, video, audio (space-separated)
METHODS=identical image video audio
# 0: run once and exit. 86400: once a day, as long as the container runs.
INTERVAL=0
NICE=10
# Parallel readers; leave empty for the CLI default. Lower it on a small NAS.
WORKERS=2
# More options for every scan, e.g. "-v" or "--min-size 100000"
EXTRA_ARGS=
